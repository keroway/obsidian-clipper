{
  "name": "obsidian-clipper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "check": "biome check .",
    "compare:summary": "bun run scripts/compare-summary-models.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/bun": "^1.4.2",
    "lefthook": "^2.1.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  },
  "overrides": {
    "sharp": "0.35.4",
    "nanoid": "^3.3.19",
    "postcss": "^8.5.28",
    "undici": "^7.29.1"
  }
}

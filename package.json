{
  "name": "obsidian-clipper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p tsconfig.vitest.json",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "check": "biome check .",
    "compare:summary": "bun run scripts/compare-summary-models.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/bun": "^1.4.4",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "nanoid": "^6.0.2",
    "postcss": "^8.5.32",
    "source-map-js": "^1.2.2",
    "undici": "^8.12.4",
    "vite": "~8.3.6",
    "zod": "~4.6.7"
  }
}
